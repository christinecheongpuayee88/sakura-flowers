---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-logo">桜 Sakura Flowers</span>
      <p class="footer-tagline">Handcrafted arrangements inspired<br>by Japanese floral artistry.</p>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      <div class="footer-col">
        <h4>Shop</h4>
        <a href="/#collections">Collections</a>
        <a href="/#occasions">Occasions</a>
        <a href="/#contact">Custom Orders</a>
      </div>
      <div class="footer-col">
        <h4>Studio</h4>
        <a href="/#about">Our Story</a>
        <a href="/blog">Journal</a>
        <a href="/#contact">Contact</a>
      </div>
    </nav>
  </div>

  <div class="footer-bottom">
    <p>© {year} Sakura Flowers. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--green);
    color: rgba(255,255,255,0.75);
    padding: 80px 48px 32px;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 64px;
    max-width: 1200px;
    margin: 0 auto;
    padding-bottom: 64px;
    border-bottom: 1px solid rgba(255,255,255,0.12);
  }
  .footer-logo {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    color: #fff;
    margin-bottom: 16px;
  }
  .footer-tagline {
    font-size: 14px;
    line-height: 1.7;
    color: rgba(255,255,255,0.55);
  }
  .footer-links {
    display: flex;
    gap: 64px;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .footer-col h4 {
    font-family: 'Playfair Display', serif;
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .footer-col a {
    font-size: 14px;
    color: rgba(255,255,255,0.6);
    transition: color 0.2s;
    text-decoration: none;
  }
  .footer-col a:hover { color: var(--accent); }
  .footer-bottom {
    max-width: 1200px;
    margin: 32px auto 0;
    font-size: 13px;
    color: rgba(255,255,255,0.35);
  }
  @media (max-width: 768px) {
    .site-footer { padding: 60px 24px 28px; }
    .footer-inner { flex-direction: column; gap: 40px; }
    .footer-links { gap: 40px; }
  }
</style>
