---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const { frontmatter } = Astro.props;
const dateStr = frontmatter.date
  ? new Date(frontmatter.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';
---

<Base title={`${frontmatter.title} — Sakura Flowers`} description={frontmatter.description} ogImage={frontmatter.image}>
  <Nav />
  <main class="post-main">
    <article class="post-article">
      <header class="post-header">
        {dateStr && <time class="post-date">{dateStr}</time>}
        <h1 class="post-title">{frontmatter.title}</h1>
        <p class="post-description">{frontmatter.description}</p>
      </header>
      {frontmatter.image && (
        <div class="post-hero-img">
          <img src={frontmatter.image} alt={frontmatter.title} loading="eager" />
        </div>
      )}
      <div class="post-body">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .post-main {
    padding-top: 120px;
    padding-bottom: 120px;
    background: var(--bg);
    min-height: 100vh;
  }
  .post-article {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .post-header { margin-bottom: 48px; }
  .post-date {
    display: block;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 16px;
  }
  .post-title {
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 600;
    color: var(--text);
    margin-bottom: 16px;
  }
  .post-description {
    font-size: 18px;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .post-hero-img {
    margin-bottom: 48px;
    aspect-ratio: 16/9;
    overflow: hidden;
  }
  .post-hero-img img {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .post-body {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text);
  }
  .post-body h2 {
    font-size: 28px;
    margin: 48px 0 16px;
    color: var(--text);
  }
  .post-body h3 {
    font-size: 22px;
    margin: 36px 0 12px;
    color: var(--text);
  }
  .post-body p { margin-bottom: 24px; }
  .post-body ul, .post-body ol {
    margin: 0 0 24px 24px;
  }
  .post-body li { margin-bottom: 8px; }
  .post-body a { color: var(--primary); text-decoration: underline; }
  .post-body strong { font-weight: 600; }
  .post-body em { font-style: italic; }
  .post-body blockquote {
    border-left: 3px solid var(--primary);
    padding: 12px 24px;
    margin: 32px 0;
    color: var(--text-muted);
    font-style: italic;
  }
  .post-body img {
    width: 100%;
    margin: 32px 0;
  }
  .post-body hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 48px 0;
  }
</style>
