---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const { frontmatter } = Astro.props;
---

<Base title={`${frontmatter.title} — Sakura Flowers`} description={frontmatter.description} ogImage={frontmatter.image}>
  <Nav />
  <main class="page-main">
    <article class="page-article">
      <header class="page-header">
        <h1 class="page-title">{frontmatter.title}</h1>
        <p class="page-description">{frontmatter.description}</p>
      </header>
      {frontmatter.image && (
        <div class="page-hero-img">
          <img src={frontmatter.image} alt={frontmatter.title} loading="eager" />
        </div>
      )}
      <div class="page-body">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .page-main {
    padding-top: 120px;
    padding-bottom: 120px;
    background: var(--bg);
    min-height: 100vh;
  }
  .page-article {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .page-header { margin-bottom: 48px; }
  .page-title {
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 600;
    color: var(--text);
    margin-bottom: 16px;
  }
  .page-description {
    font-size: 18px;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .page-hero-img {
    margin-bottom: 48px;
    aspect-ratio: 16/7;
    overflow: hidden;
  }
  .page-hero-img img {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .page-body {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text);
  }
  .page-body h2 {
    font-size: 28px;
    margin: 48px 0 16px;
  }
  .page-body p { margin-bottom: 24px; }
  .page-body ul, .page-body ol {
    margin: 0 0 24px 24px;
  }
  .page-body a { color: var(--primary); text-decoration: underline; }
</style>
